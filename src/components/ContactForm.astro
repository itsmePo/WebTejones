---
import { contactConfig } from "../config/contact";
const consentText = "Acepto el tratamiento de mis datos para gestionar la solicitud de contratación conforme a la";
---

<div class="contacto-wrapper" id="contacto-form-root">
  <form id="contact-form" action={contactConfig.endpoint || "/api/contacto"} method="POST" novalidate>
    <div class="form-group">
      <label for="nombre">Nombre o entidad <span class="required">*</span></label>
      <input type="text" id="nombre" name="nombre" required autocomplete="name" />
      <span class="field-error" aria-live="polite" data-for="nombre"></span>
    </div>

    <div class="form-group">
      <label for="email">Correo electrónico <span class="required">*</span></label>
      <input type="email" id="email" name="email" required autocomplete="email" />
      <span class="field-error" aria-live="polite" data-for="email"></span>
    </div>

    <div class="form-group">
      <label for="telefono">Teléfono de contacto (opcional)</label>
      <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
      <span class="field-error" aria-live="polite" data-for="telefono"></span>
    </div>

    <div class="form-group">
      <label for="mensaje">Detalles del evento / Mensaje <span class="required">*</span></label>
      <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Fecha, lugar, tipo de evento..."></textarea>
      <span class="field-error" aria-live="polite" data-for="mensaje"></span>
    </div>

    <!-- Honeypot anti-spam oculto -->
    <div class="hp-field" style="display:none;" aria-hidden="true">
      <label for="honeypot">No rellenar si eres humano</label>
      <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Timestamp para control de velocidad anti-bot -->
    <input type="hidden" id="timestamp" name="timestamp" value="" />

    <div class="form-group checkbox-group">
      <label class="checkbox-label">
        <input type="checkbox" id="consentimiento" name="consentimiento" required />
        <span>{consentText} <a href="/privacidad" target="_blank" rel="noreferrer">Política de Privacidad</a>.</span>
      </label>
      <span class="field-error" aria-live="polite" data-for="consentimiento"></span>
    </div>

    <button type="submit" class="boton-enviar" id="submit-btn">
      ENVIAR SOLICITUD <span>↗</span>
    </button>

    <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
  </form>
</div>

<script>
  import "../scripts/contact-form";
</script>

<style>
  .contacto-wrapper {
    max-width: 600px;
    margin: 0 auto;
  }

  .form-group {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    text-transform: uppercase;
    color: #b0a89f;
  }

  .required {
    color: #c6a15b;
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 14px 16px;
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: #c6a15b;
  }

  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    margin-top: 10px;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.85rem;
    line-height: 1.4;
    text-transform: none;
    color: #888078;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    margin-top: 2px;
    accent-color: #c6a15b;
    width: 18px;
    height: 18px;
  }

  .checkbox-label a {
    color: #c6a15b;
    text-decoration: underline;
  }

  .field-error {
    font-size: 0.75rem;
    color: #ff6b6b;
    min-height: 14px;
  }

  .boton-enviar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 16px 28px;
    background-color: #c6a15b;
    color: #0a0a0a;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    margin-top: 10px;
  }

  .boton-enviar:hover {
    background-color: #d8b46b;
    transform: translateY(-2px);
  }

  .form-status {
    margin-top: 20px;
    padding: 15px;
    font-size: 0.9rem;
    text-align: center;
    display: none;
  }

  .form-status.success {
    display: block;
    background: rgba(40, 167, 69, 0.15);
    border: 1px solid rgba(40, 167, 69, 0.4);
    color: #51cf66;
  }

  .form-status.error {
    display: block;
    background: rgba(220, 53, 69, 0.15);
    border: 1px solid rgba(220, 53, 69, 0.4);
    color: #ff6b6b;
  }
</style>
