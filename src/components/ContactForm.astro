---
import { contactConfig } from "../config/contact";
---

<form
  class="formulario"
  name={contactConfig.formName}
  method="POST"
  action={contactConfig.endpoint || undefined}
  data-contact-form
  data-mode={contactConfig.mode}
  aria-label="Formulario de contacto para contratación"
>
  <p class="nota-obligatorios">
    Los campos marcados con <span aria-hidden="true">*</span> son obligatorios.
  </p>

  <div class="rejilla">
    <div class="campo" data-field>
      <label for="nombre">Nombre y apellidos <span class="obligatorio" aria-hidden="true">*</span></label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
        aria-describedby="error-nombre"
      />
      <p class="mensaje-error" id="error-nombre" data-error-for="nombre" aria-live="polite"></p>
    </div>

    <div class="campo" data-field>
      <label for="email">Email <span class="obligatorio" aria-hidden="true">*</span></label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="120"
        aria-describedby="error-email"
      />
      <p class="mensaje-error" id="error-email" data-error-for="email" aria-live="polite"></p>
    </div>

    <div class="campo" data-field>
      <label for="telefono">Teléfono</label>
      <input
        id="telefono"
        name="telefono"
        type="tel"
        autocomplete="tel"
        maxlength="30"
        aria-describedby="error-telefono"
      />
      <p class="mensaje-error" id="error-telefono" data-error-for="telefono" aria-live="polite"></p>
    </div>

    <div class="campo" data-field>
      <label for="tipoEvento">Tipo de evento <span class="obligatorio" aria-hidden="true">*</span></label>
      <select id="tipoEvento" name="tipoEvento" required aria-describedby="error-tipoEvento">
        <option value="">Selecciona una opción</option>
        <option value="concierto privado">Concierto privado</option>
        <option value="fiesta mayor">Fiesta mayor</option>
        <option value="boda">Boda</option>
        <option value="empresa">Evento de empresa</option>
        <option value="otro">Otro</option>
      </select>
      <p class="mensaje-error" id="error-tipoEvento" data-error-for="tipoEvento" aria-live="polite"></p>
    </div>

    <div class="campo" data-field>
      <label for="fechaEvento">Fecha del evento</label>
      <input
        id="fechaEvento"
        name="fechaEvento"
        type="date"
        aria-describedby="error-fechaEvento"
      />
      <p class="mensaje-error" id="error-fechaEvento" data-error-for="fechaEvento" aria-live="polite"></p>
    </div>

    <div class="campo" data-field>
      <label for="lugar">Lugar / localidad</label>
      <input
        id="lugar"
        name="lugar"
        type="text"
        autocomplete="address-level2"
        maxlength="120"
        aria-describedby="error-lugar"
      />
      <p class="mensaje-error" id="error-lugar" data-error-for="lugar" aria-live="polite"></p>
    </div>

    <div class="campo campo--ancho" data-field>
      <label for="mensaje">Mensaje <span class="obligatorio" aria-hidden="true">*</span></label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="5"
        required
        minlength="10"
        maxlength="2000"
        placeholder="Cuéntanos qué tienes en mente: tipo de evento, público, horario, presupuesto…"
        aria-describedby="error-mensaje"
      ></textarea>
      <p class="mensaje-error" id="error-mensaje" data-error-for="mensaje" aria-live="polite"></p>
    </div>

    <div class="campo campo--consentimiento" data-field>
      <label class="checkbox" for="privacidad">
        <input
          id="privacidad"
          name="privacidad"
          type="checkbox"
          value="si"
          required
          aria-describedby="error-privacidad"
        />
        <span>
          Acepto la{" "}
          <a href="/privacidad" target="_blank" rel="noopener">
            política de privacidad
            <span class="texto-oculto">{" "}(se abre en una nueva pestaña)</span>
          </a>{" "}
          y el tratamiento de mis datos para responder a esta solicitud.
        </span>
      </label>
      <p class="mensaje-error" id="error-privacidad" data-error-for="privacidad" aria-live="polite"></p>
    </div>
  </div>

  <input type="hidden" name="_subject" value="Nueva solicitud de contratación — Tejones" />
  <input type="hidden" name="_startedAt" value="" data-form-started />

  <div class="honeypot" aria-hidden="true">
    <label for="_gotcha">No rellenar</label>
    <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="acciones">
    <button class="boton-enviar" type="submit" data-submit-button>
      <span data-submit-label>ENVIAR SOLICITUD</span>
      <span aria-hidden="true">↗</span>
    </button>
  </div>

  <p class="estado" data-form-status role="status" aria-live="polite"></p>

  {
    contactConfig.mode === "dev" && (
      <p class="aviso-local">
        Modo local: el envío está simulado hasta conectar el servicio de correo del
        hosting.
      </p>
    )
  }

  {
    contactConfig.mode === "unconfigured" && (
      <p class="aviso-local aviso-local--pendiente">
        El formulario todavía no está conectado. Escríbenos por Instagram mientras
        terminamos de configurarlo.
      </p>
    )
  }
</form>

<script>
  import { initContactForm } from "../scripts/contact-form";

  initContactForm();
</script>

<style>
  .formulario {
    max-width: 760px;
    margin-top: 48px;
    color-scheme: dark;
  }

  .nota-obligatorios {
    margin: 0 0 24px;
    color: #888078;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .nota-obligatorios span,
  .obligatorio {
    color: #c6a15b;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .campo--ancho,
  .campo--consentimiento {
    grid-column: 1 / -1;
  }

  label {
    color: #d8d0c5;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid #ffffff24;
    border-radius: 0;
    color: #f5f0e7;
    background: #0a0a0a;
    font: inherit;
    font-size: 0.95rem;
    padding: 14px 15px;
    transition: border-color 180ms ease, outline-color 180ms ease;
  }

  textarea {
    min-height: 140px;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #6f6860;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: #c6a15b;
    outline: 1px solid #c6a15b;
    outline-offset: 2px;
  }

  .campo--error input,
  .campo--error select,
  .campo--error textarea {
    border-color: #e6a6a6;
  }

  .mensaje-error {
    min-height: 1em;
    margin: 0;
    color: #e6a6a6;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #bcb5ab;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
    text-transform: none;
  }

  .checkbox input {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    padding: 0;
    border: 0;
    background: transparent;
    accent-color: #c6a15b;
  }

  .checkbox a {
    color: #c6a15b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .texto-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 26px;
  }

  .boton-enviar {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 0 26px;
    border: 1px solid #c6a15b;
    border-radius: 0;
    color: #f5f0e7;
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: background 180ms ease, color 180ms ease, opacity 180ms ease;
  }

  .boton-enviar:hover:not(:disabled) {
    color: #0a0a0a;
    background: #c6a15b;
  }

  .boton-enviar:focus-visible {
    outline: 1px solid #c6a15b;
    outline-offset: 4px;
  }

  .boton-enviar:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .estado {
    min-height: 1.4em;
    margin: 18px 0 0;
    color: #bcb5ab;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .estado[data-state="success"] {
    color: #c6a15b;
  }

  .estado[data-state="error"] {
    color: #e6a6a6;
  }

  .aviso-local {
    margin: 14px 0 0;
    color: #888078;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .aviso-local--pendiente {
    color: #e6a6a6;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .formulario {
      margin-top: 36px;
    }

    .rejilla {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    select,
    textarea,
    .boton-enviar {
      transition: none;
    }
  }
</style>
