---
interface PressItem {
  fecha: string;
  lugar: string;
  titulo: string;
  enlace?: string;
  permiso?: boolean;
}

interface MilestoneItem {
  fecha: string;
  lugar: string;
  titulo: string;
  permiso?: boolean;
}

interface FormatItem {
  clave: string;
  contenido: string;
}

interface GigItem {
  fechaIso: string;
  hora: string;
  lugar: string;
  titulo: string;
  enlace?: string;
}

interface Props {
  pressItems?: PressItem[];
  milestones?: MilestoneItem[];
  formatItems?: FormatItem[];
  gigs?: GigItem[];
}

const { pressItems = [], milestones = [], formatItems = [], gigs = [] } = Astro.props;
---

{pressItems.length > 0 && (
  <section class="seccion-editorial" id="prensa">
    <p class="etiqueta">PRENSA Y MENCIONES</p>
    <h2>LO QUE DICEN<br />DE NOSOTROS.</h2>
    <div class="grid-editorial">
      {pressItems.map((item) => (
        <article class="card">
          <span class="meta">{item.fecha} · {item.lugar}</span>
          <h3>{item.titulo}</h3>
          {item.enlace && (
            <a href={item.enlace} target="_blank" rel="noreferrer" class="enlace-externo">
              Leer mención <span>↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
)}

{milestones.length > 0 && (
  <section class="seccion-editorial" id="trayectoria">
    <p class="etiqueta">TRAYECTORIA</p>
    <h2>HITOS Y ESCENARIOS<br />RECORRIDOS.</h2>
    <div class="timeline">
      {milestones.map((item) => (
        <div class="timeline-item">
          <span class="meta">{item.fecha}</span>
          <h3>{item.titulo}</h3>
          <p>{item.lugar}</p>
        </div>
      ))}
    </div>
  </section>
)}

{formatItems.length > 0 && (
  <section class="seccion-editorial" id="repertorio">
    <p class="etiqueta">FORMATO Y REPERTORIO</p>
    <h2>DIRECTO A MEDIDA<br />PARA TU EVENTO.</h2>
    <div class="format-grid">
      {formatItems.map((item) => (
        <div class="format-card">
          <h3>{item.clave}</h3>
          <p>{item.contenido}</p>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .seccion-editorial {
    padding: 80px 7%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .etiqueta {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #c6a15b;
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  h2 {
    font-size: 2.2rem;
    line-height: 1.1;
    font-weight: 900;
    margin-bottom: 40px;
    letter-spacing: -0.02em;
  }

  .grid-editorial, .format-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .card, .format-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .meta {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #888078;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .card h3, .format-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 15px;
    line-height: 1.3;
  }

  .format-card p, .card p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #b0a89f;
  }

  .enlace-externo {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #c6a15b;
    text-decoration: none;
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 30px;
    border-left: 2px solid rgba(198, 161, 91, 0.3);
    padding-left: 25px;
    margin-left: 10px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -31px;
    top: 4px;
    width: 10px;
    height: 10px;
    background-color: #c6a15b;
    border-radius: 50%;
  }

  .timeline-item h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .timeline-item p {
    font-size: 0.85rem;
    color: #888078;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.8rem;
    }
  }
</style>
