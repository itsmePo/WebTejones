---
interface Slide {
  title: string;
  caption: string;
  src?: string;
  alt?: string;
  tone: string;
}

const slides: Slide[] = [
  { title: "En directo", caption: "La energía del escenario", tone: "74 40 28" },
  { title: "Público", caption: "Himnos que se cantan solos", tone: "58 42 27" },
  { title: "Escenario", caption: "Luces, guitarras y noches largas", tone: "44 29 24" },
  { title: "La banda", caption: "Rock sin filtros", tone: "74 40 28" },
  { title: "Gira", caption: "Carretera y sonido analógico", tone: "60 35 25" },
  { title: "Backstage", caption: "Antes de salir a romper cuerdas", tone: "50 30 20" },
  { title: "Festivales", caption: "Noches mágicas bajo los focos", tone: "65 45 30" },
  { title: "Acústico", caption: "Intimidad y cercanía con el público", tone: "50 35 25" },
];

const total = slides.length;
const formatNumber = (value: number) => String(value).padStart(2, "0");
---

<div class="slider-container" id="gallery-slider-root">
  <div class="slider-cabecera">
    <p class="slider-etiqueta">GALERÍA · EN DIRECTO (PREVISUALIZACIÓN)</p>
  </div>

  <div class="slider-viewport" id="slider-viewport">
    {
      slides.map((slide, index) => (
        <figure class="slide" style={`--tono: ${slide.tone}`}>
          <div class="marco-foto">
            {slide.src ? (
              <img src={slide.src} alt={slide.alt ?? ""} loading="lazy" />
            ) : (
              <div class="placeholder-preview">
                <div class="placeholder-icon">📷</div>
                <span class="placeholder-numero">FOTO {formatNumber(index + 1)}</span>
                <span class="placeholder-texto">Próximamente contenido real</span>
              </div>
            )}
            <span class="marco-esquinas" aria-hidden="true" />
          </div>
          <figcaption class="slide-pie">
            <span class="slide-titulo">{slide.title}</span>
            <span class="slide-descripcion">{slide.caption}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="slider-controles">
    <div class="slider-flechas">
      <button type="button" class="boton-flecha" id="slider-prev" aria-label="Anterior">←</button>
      <button type="button" class="boton-flecha" id="slider-next" aria-label="Siguiente">→</button>
    </div>
  </div>
</div>

<script>
  const viewport = document.getElementById('slider-viewport');
  const btnPrev = document.getElementById('slider-prev');
  const btnNext = document.getElementById('slider-next');

  if (viewport && btnPrev && btnNext) {
    const scrollAmount = 340; // Ancho de tarjeta + gap

    btnPrev.addEventListener('click', () => {
      viewport.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', () => {
      viewport.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }
</script>

<style>
  .slider-container {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .slider-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-etiqueta {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #c6a15b;
    text-transform: uppercase;
    font-weight: 700;
  }

  .slider-viewport {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
  }

  .slider-viewport::-webkit-scrollbar {
    height: 6px;
  }
  .slider-viewport::-webkit-scrollbar-thumb {
    background: rgba(198, 161, 91, 0.3);
    border-radius: 3px;
  }

  .slide {
    flex: 0 0 320px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  .marco-foto {
    position: relative;
    width: 100%;
    height: 400px;
    background: linear-gradient(135deg, rgba(var(--tono), 0.2), rgba(10, 10, 10, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
    color: #b0a89f;
  }

  .placeholder-icon {
    font-size: 2.5rem;
    opacity: 0.7;
  }

  .placeholder-numero {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #c6a15b;
  }

  .placeholder-texto {
    font-size: 0.8rem;
    color: #888078;
    line-height: 1.4;
  }

  .marco-esquinas {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }

  .slide-pie {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .slide-titulo {
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .slide-descripcion {
    color: #888078;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .slider-controles {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-flechas {
    display: flex;
    gap: 10px;
  }

  .boton-flecha {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.2s ease;
  }

  .boton-flecha:hover {
    background: #c6a15b;
    color: #0a0a0a;
    border-color: #c6a15b;
  }

  @media (max-width: 768px) {
    .slide {
      flex: 0 0 280px;
    }
    .marco-foto {
      height: 340px;
    }
  }
</style>
