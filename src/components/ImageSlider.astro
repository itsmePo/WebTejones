---
interface Slide {
  title: string;
  caption: string;
  src?: string;
  alt?: string;
  tone: string;
}

const slides: Slide[] = [
  {
    title: "En directo",
    caption: "La energía del escenario",
    tone: "74 40 28",
  },
  {
    title: "Público",
    caption: "Himnos que se cantan solos",
    tone: "58 42 27",
  },
  {
    title: "Escenario",
    caption: "Luces, guitarras y noches largas",
    tone: "44 29 24",
  },
  {
    title: "La banda",
    caption: "Rock sin filtros",
    tone: "74 40 28",
  },
];

const total = slides.length;
const formatNumber = (value: number) => String(value).padStart(2, "0");
---

<div
  class="slider"
  data-slider
  role="region"
  aria-roledescription="carrusel"
  aria-label="Galería de imágenes de Tejones"
>
  <div class="slider-cabecera">
    <p class="slider-etiqueta">GALERÍA · EN DIRECTO</p>
    <p class="slider-contador" aria-hidden="true">
      <span data-slider-current>{formatNumber(1)}</span>
      <span class="separador">/</span>
      <span>{formatNumber(total)}</span>
    </p>
  </div>

  <div
    class="slider-viewport"
    id="galeria-slider"
    data-slider-viewport
    tabindex="0"
    role="group"
    aria-label="Galería de imágenes de Tejones. Usa las flechas izquierda y derecha para navegar."
  >
    {
      slides.map((slide, index) => (
        <figure
          class="slide"
          data-slide
          data-slide-title={slide.title}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${total}`}
          style={`--tono: ${slide.tone}`}
        >
          <div class="marco-foto">
            {slide.src ? (
              <img
                src={slide.src}
                alt={slide.alt ?? ""}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ) : (
              <span class="placeholder" aria-hidden="true">
                <span class="placeholder-numero">{formatNumber(index + 1)}</span>
                <span class="placeholder-texto">Espacio para imagen</span>
              </span>
            )}
            <span class="marco-esquinas" aria-hidden="true" />
          </div>

          <figcaption class="slide-pie">
            <span class="slide-titulo">{slide.title}</span>
            <span class="slide-descripcion">{slide.caption}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="slider-controles">
    <div class="slider-flechas">
      <button
        type="button"
        class="boton-flecha"
        data-slider-prev
        aria-label="Imagen anterior"
        aria-controls="galeria-slider"
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        type="button"
        class="boton-flecha"
        data-slider-next
        aria-label="Imagen siguiente"
        aria-controls="galeria-slider"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="slider-puntos" role="group" aria-label="Seleccionar imagen">
      {
        slides.map((slide, index) => (
          <button
            type="button"
            class="punto"
            data-slider-dot
            aria-label={`Ir a la imagen ${index + 1}: ${slide.title}`}
            aria-current={index === 0 ? "true" : "false"}
            aria-controls="galeria-slider"
          />
        ))
      }
    </div>

    <p class="slider-instruccion" aria-hidden="true">DESLIZA O USA ← →</p>
  </div>

  <p class="sr-only" data-slider-status aria-live="polite"></p>
</div>

<script>
  import { initImageSliders } from "../scripts/image-slider";

  initImageSliders();
</script>

<style>
  .slider {
    margin-top: 52px;
  }

  .slider-cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  .slider-etiqueta {
    margin: 0;
    color: #c6a15b;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.28em;
  }

  .slider-contador {
    margin: 0;
    color: #6f6860;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
  }

  .slider-contador span:first-child {
    color: #f5f0e7;
  }

  .separador {
    margin: 0 6px;
    color: #6f6860;
  }

  .slider-viewport {
    position: relative;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .slider-viewport::-webkit-scrollbar {
    display: none;
  }

  .slider-viewport:focus-visible {
    outline: 1px solid #c6a15b;
    outline-offset: 4px;
  }

  .slide {
    flex: 0 0 100%;
    min-width: 0;
    margin: 0;
    scroll-snap-align: start;
  }

  .marco-foto {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid #ffffff12;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 26px,
        rgb(198 161 91 / 0.03) 26px 27px
      ),
      radial-gradient(
        ellipse at 70% 20%,
        rgb(var(--tono) / 0.45) 0%,
        transparent 60%
      ),
      linear-gradient(135deg, #15110d 0%, #0b0a09 100%);
  }

  .marco-foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .marco-esquinas {
    position: absolute;
    inset: 20px;
    pointer-events: none;
    background:
      linear-gradient(#c6a15b66, #c6a15b66) left top / 28px 1px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) left top / 1px 28px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) right top / 28px 1px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) right top / 1px 28px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) left bottom / 28px 1px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) left bottom / 1px 28px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) right bottom / 28px 1px no-repeat,
      linear-gradient(#c6a15b66, #c6a15b66) right bottom / 1px 28px no-repeat;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .placeholder-numero {
    color: rgb(198 161 91 / 0.22);
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .placeholder-texto {
    color: rgb(198 161 91 / 0.55);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .placeholder-texto::after {
    content: "";
    display: block;
    width: 46px;
    height: 1px;
    margin: 12px auto 0;
    background: rgb(198 161 91 / 0.35);
  }

  .slide-pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding-top: 14px;
  }

  .slide-titulo {
    color: #c6a15b;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .slide-descripcion {
    color: #888078;
    font-size: 0.72rem;
    text-align: right;
  }

  .slider-controles {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 22px;
  }

  .slider-flechas {
    display: flex;
    gap: 8px;
  }

  .boton-flecha {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #ffffff24;
    color: #f5f0e7;
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .boton-flecha:hover {
    border-color: #c6a15b;
    color: #c6a15b;
  }

  .boton-flecha:focus-visible {
    outline: 1px solid #c6a15b;
    outline-offset: 3px;
  }

  .slider-puntos {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .punto {
    position: relative;
    width: 28px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .punto::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 4px;
    left: 4px;
    height: 2px;
    background: #ffffff26;
    transform: translateY(-50%);
    transition: background 180ms ease;
  }

  .punto:hover::before {
    background: rgb(198 161 91 / 0.55);
  }

  .punto[aria-current="true"]::before {
    background: #c6a15b;
  }

  .punto:focus-visible {
    outline: 1px solid #c6a15b;
    outline-offset: 2px;
  }

  .slider-instruccion {
    margin: 0;
    color: #6f6860;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .slider {
      margin-top: 36px;
    }

    .marco-foto {
      aspect-ratio: 4 / 3;
    }

    .marco-esquinas {
      inset: 12px;
    }

    .slide-pie {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .slide-descripcion {
      text-align: left;
    }

    .slider-instruccion {
      display: none;
    }

    .slider-controles {
      margin-top: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boton-flecha,
    .punto::before {
      transition: none;
    }
  }
</style>
