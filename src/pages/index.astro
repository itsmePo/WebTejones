---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ImageSlider from "../components/ImageSlider.astro";
import Hero from "../components/Hero.astro";
---

<Layout
  title="Tejones Banda | Premium Cover Band"
  description="Tejones Banda. Rock español e internacional de los 80, 90 y 2000 para eventos, ayuntamientos y celebraciones privadas."
>
      <main>
        <nav class="navegacion">
          <a class="marca" href="#inicio">TEJONES<span>.</span></a>
          <a class="contacto" href="#contacto">CONTRATACIÓN ↗</a>
        </nav>

        <Hero />

        <section class="presentacion" id="directo">
          <p class="etiqueta">NO ES SOLO MÚSICA</p>
          <h2>ES UNA NOCHE<br />PARA RECORDAR.</h2>
          <p>
            Rock español e internacional. Grandes himnos, guitarras
            y un directo pensado para hacer vibrar al público.
          </p>

          <ImageSlider />
        </section>

        <section class="contratacion" id="contacto">
          <p class="etiqueta">¿PREPARAMOS ALGO GRANDE?</p>
          <h2>EL ESCENARIO<br />NOS ESPERA.</h2>
          <p>Eventos · Ayuntamientos · Celebraciones privadas</p>

          <ContactForm />

          <p class="instagram">
            ¿Quieres ver antes cómo suena?{" "}
            <a href="https://www.instagram.com/tejonesbanda/" target="_blank" rel="noreferrer">
              Síguenos en Instagram <span>↗</span>
            </a>
          </p>
        </section>

        <footer>
          <div class="footer-left">
            <a class="marca" href="#inicio">TEJONES<span>.</span></a>
            <p>PREMIUM COVER BAND · ROCK EN DIRECTO</p>
          </div>
          <div class="footer-right">
            <div class="legal-links">
              <a href="/privacidad">Política de Privacidad</a>
              <span>·</span>
              <a href="/aviso-legal">Aviso Legal</a>
            </div>
            <div class="pandacode-credit">
              Made by <a href="https://www.linkedin.com/in/borja-garc%C3%ADa-g%C3%B3mez-de-segura-287441328/" target="_blank" rel="noreferrer" class="pandacode-link">PandaCode<span class="panda-emoji">🐼</span></a>
            </div>
          </div>
        </footer>
      </main>
</Layout>

<style>
  .navegacion {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 30px 7%;
  }

  .marca {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .marca span {
    color: #c6a15b;
  }

  .contacto {
    padding-bottom: 7px;
    border-bottom: 1px solid #c6a15b;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .presentacion, .contratacion {
    padding: 80px 7%;
  }

  .etiqueta {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #c6a15b;
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  h2 {
    font-size: 2.2rem;
    line-height: 1.1;
    font-weight: 900;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    padding: 40px 7%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #888078;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .legal-links {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .legal-links a {
    color: #888078;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal-links a:hover {
    color: #c6a15b;
    text-decoration: underline;
  }

  .pandacode-credit {
    color: #888078;
  }

  .pandacode-link {
    color: #b0a89f;
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .panda-emoji {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transform: scale(0.5);
    white-space: nowrap;
    transition: max-width 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .pandacode-link:hover {
    color: #ffffff;
    transform: scale(1.05);
  }

  .pandacode-link:hover .panda-emoji {
    max-width: 30px;
    opacity: 1;
    transform: scale(1) rotate(10deg);
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.8rem;
    }
    footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .footer-right {
      align-items: flex-start;
    }
  }
</style>
